# Meta Pixel + Conversions API
# ID du pixel : Events Manager > Sources de données > ton pixel
NEXT_PUBLIC_META_PIXEL_ID=
# Token CAPI : Events Manager > ton pixel > Paramètres > API Conversions > Générer un token
META_CAPI_ACCESS_TOKEN=
# Optionnel, uniquement pour tester : Events Manager > onglet "Événements de test"
# Ne JAMAIS définir en production (les événements de test n'optimisent pas les pubs)
# META_TEST_EVENT_CODE=

# DocuSeal (contrats envoyés depuis /admin/ventes). Un modèle par nombre de
# paiements ; les identifiants changent entre le mode test et la production.
# DOCUSEAL_API_KEY=
# DOCUSEAL_API_URL=https://api.docuseal.com
# DOCUSEAL_TEMPLATE_1X=
# DOCUSEAL_TEMPLATE_2X=
# DOCUSEAL_TEMPLATE_3X=
# Webhook DocuSeal : URL https://www.jeremypitault.com/api/webhook/docuseal,
# en-tête X-Docuseal-Secret = cette valeur.
# DOCUSEAL_WEBHOOK_SECRET=
